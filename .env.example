# ---------- Aura API (Console > Account settings > Client credentials > Aura API) ----------
AURA_CLIENT_ID=
AURA_CLIENT_SECRET=
AURA_API_BASE=https://api.neo4j.io
# Optional. If blank, bg discovers them when the credentials see exactly one organization and project.
AURA_ORG_ID=
AURA_PROJECT_ID=

# ---------- Aura instance the harness creates (billed while it exists) ----------
AURA_INSTANCE_NAME_PREFIX=bg-demo
AURA_CLOUD_PROVIDER=gcp
# REQUIRED. A region where your org can create Business Critical.
# Keep comments on their own line when a value is empty - python-dotenv would read an inline comment as the value.
AURA_REGION=
AURA_MEMORY=2GB
AURA_INSTANCE_TYPE=business-critical
AURA_MAX_RUNTIME_MINUTES=180
AURA_KEEP_INSTANCE=false

# ---------- Self-managed EE baseline ----------
NEO4J_TAG=2026.10.1
# Accepts the Neo4j Enterprise license (https://neo4j.com/licensing/). Use only under terms you are entitled to.
NEO4J_ACCEPT_LICENSE_AGREEMENT=yes
NEO4J_LOCAL_PASSWORD=change-me-local

# ---------- Workload ----------
TENANTS=acme,globex,initech
SCALE=1
SEED=42
ADMIN_HEAP_SIZE=2g
KEEP_DUMPS=false
