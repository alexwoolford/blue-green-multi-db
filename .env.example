# ---------- Aura API (Console > Account settings > Client credentials > Aura API) ----------
AURA_CLIENT_ID=
AURA_CLIENT_SECRET=
AURA_API_BASE=https://api.neo4j.io
# Optional. If blank, bg discovers them when the credentials see exactly one organization and project.
AURA_ORG_ID=
AURA_PROJECT_ID=

# ---------- Aura instance the harness creates (billed while it exists) ----------
AURA_INSTANCE_NAME_PREFIX=bg-demo
AURA_CLOUD_PROVIDER=gcp
# REQUIRED. A region where your org can create Business Critical.
# Keep comments on their own line when a value is empty - python-dotenv would read an inline comment as the value.
AURA_REGION=
AURA_MEMORY=2GB
AURA_INSTANCE_TYPE=business-critical
AURA_MAX_RUNTIME_MINUTES=180
AURA_KEEP_INSTANCE=false

# ---------- Aura pause/resume (optional, not part of the blue/green pattern) ----------
# 0 skips pause/resume in bg e2e. Set to 1 or more to also time a whole-instance
# pause and resume and check that aliases and data survive it (adds about 5 minutes).
PAUSE_ITERATIONS=0
PAUSE_HOLD_SECONDS=120
# Published instance-actions docs and the aura-go-sdk v1 client use
# POST /v1/instances/{id}/pause|resume. The v2beta1 instance client has no
# pause method. Leave this as v1 unless the published API spec shows another path.
AURA_PAUSE_API=v1
# Used only when AURA_PAUSE_API=custom, e.g. /v2beta1/.../instances/{instance_id}/pause
AURA_PAUSE_PATH_TEMPLATE=
AURA_RESUME_PATH_TEMPLATE=

# ---------- Self-managed EE baseline ----------
NEO4J_TAG=2026.10.1
# Accepts the Neo4j Enterprise license (https://neo4j.com/licensing/). Use only under terms you are entitled to.
NEO4J_ACCEPT_LICENSE_AGREEMENT=yes
NEO4J_LOCAL_PASSWORD=change-me-local

# ---------- Workload ----------
TENANTS=acme,globex,initech
SCALE=1
SEED=42
ADMIN_HEAP_SIZE=2g
SWITCH_MODE=auto
KEEP_DUMPS=false
IMPORT_WITH_SCHEMA=false
